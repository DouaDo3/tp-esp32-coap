# Copier ce fichier en ".env" (meme dossier) puis coller VOTRE lien MongoDB Atlas.
# Atlas -> Connect -> Drivers -> copier le lien et remplacer <db_password> par le mot de passe
# de l'utilisateur de base de donnees. Laisser vide pour fonctionner sans MongoDB.
MONGODB_URI=
# Base de donnees utilisee (collections "mesures" et "commandes")
MONGODB_DB=iot_tp

  {
    "z": "tp_onglet",
    "id": "tp_template",
    "type": "template",
    "name": "page2.html",
    "field": "payload",
    "fieldType": "msg",
    "format": "html",
    "syntax": "plain",
    "template": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Smart IoT - Tableau de bord</title>\n\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n\n    body {\n      font-family: \"Segoe UI\", Arial, sans-serif;\n      min-height: 100vh;\n      background: linear-gradient(135deg, #edf4ff, #f7f9fc);\n      color: #1e293b;\n    }\n\n    header {\n      background: #fff;\n      padding: 22px 6%;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 18px;\n      flex-wrap: wrap;\n      box-shadow: 0 3px 18px #1e293b0c;\n    }\n\n    .brand { display: flex; align-items: center; gap: 12px; font-size: 23px; font-weight: 800; color: #172554; }\n    .brand-icon { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px;\n                  background: #e0edff; font-size: 25px; }\n    .brand span { color: #2563eb; }\n\n    .connection { display: flex; align-items: center; gap: 9px; background: #f1f5f9; border: 1px solid #e2e8f0;\n                  border-radius: 30px; padding: 10px 16px; font-size: 13px; color: #475569; }\n    .dot { width: 10px; height: 10px; flex-shrink: 0; border-radius: 50%; background: #f59e0b; }\n\n    main { max-width: 1100px; margin: 0 auto; padding: 45px 24px; }\n\n    .welcome { margin-bottom: 32px; }\n    .eyebrow { color: #2563eb; font-weight: 700; text-transform: uppercase; letter-spacing: 2px;\n               font-size: 12px; margin-bottom: 10px; }\n    h1 { font-size: clamp(27px, 4vw, 38px); color: #172554; margin-bottom: 12px; }\n    .subtitle { color: #64748b; font-size: 15px; line-height: 1.7; }\n\n    /* Une carte par ESP32 */\n    .boards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }\n\n    .board {\n      position: relative; overflow: hidden; background: #fff; border: 1px solid #e6edf5; border-radius: 22px;\n      padding: 26px; box-shadow: 0 12px 30px #243b530d; transition: transform .2s, box-shadow .2s;\n    }\n    .board:hover { transform: translateY(-4px); box-shadow: 0 18px 38px #243b5317; }\n    .board::after { content: \"\"; position: absolute; right: -35px; top: -40px; width: 125px; height: 125px;\n                    border-radius: 50%; opacity: .55; pointer-events: none; background: #dbeafe; }\n    .board.offline { opacity: .65; }\n\n    .board-top { position: relative; z-index: 1; display: flex; align-items: flex-start;\n                 justify-content: space-between; gap: 12px; margin-bottom: 18px; }\n    .board-name { font-size: 18px; font-weight: 800; color: #172554; word-break: break-all; }\n    .board-sub { color: #94a3b8; font-size: 12px; margin-top: 3px; }\n\n    .badge { flex-shrink: 0; font-size: 12px; font-weight: 700; padding: 6px 11px; border-radius: 20px; }\n    .badge.on { background: #dcfce7; color: #15803d; }\n    .badge.off { background: #fee2e2; color: #b91c1c; }\n\n    .values { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n    .tile { border: 1px solid #eef2f7; border-radius: 16px; padding: 14px; }\n    .tile .label { color: #64748b; font-size: 11px; font-weight: 800; letter-spacing: 1.2px; }\n    .tile .value { margin-top: 8px; font-size: clamp(24px, 3.4vw, 32px); font-weight: 800; letter-spacing: -1px; }\n    .tile .unit { font-size: 16px; font-weight: 600; }\n    .tile.temperature { background: #fff7ed; } .tile.temperature .value { color: #ea580c; }\n    .tile.humidity    { background: #eff6ff; } .tile.humidity .value { color: #2563eb; }\n    .tile.other .value { color: #334155; }\n    .flash { animation: flash .9s ease-out; }\n    @keyframes flash { from { box-shadow: 0 0 0 3px #93c5fd; } to { box-shadow: 0 0 0 0 transparent; } }\n\n    .actuator { position: relative; z-index: 1; margin-top: 18px; padding: 14px; border-radius: 16px;\n                background: #f8fafc; display: flex; align-items: center; justify-content: space-between;\n                gap: 12px; flex-wrap: wrap; }\n    .actuator-state { font-size: 14px; font-weight: 700; color: #334155; }\n    .actuator-state b.on { color: #15803d; } .actuator-state b.off { color: #64748b; }\n    .buttons { display: flex; gap: 8px; }\n    button { border: 0; border-radius: 12px; padding: 10px 16px; font: inherit; font-size: 13px; font-weight: 700;\n             cursor: pointer; transition: transform .1s, opacity .2s; }\n    button:active { transform: scale(.96); }\n    button:disabled { opacity: .45; cursor: not-allowed; }\n    .btn-on { background: #2563eb; color: #fff; }\n    .btn-off { background: #e2e8f0; color: #1e293b; }\n\n    .description { position: relative; z-index: 1; color: #94a3b8; font-size: 12px; border-top: 1px solid #f1f5f9;\n                   margin-top: 16px; padding-top: 14px; }\n\n    .empty { grid-column: 1 / -1; text-align: center; color: #94a3b8; padding: 40px 20px; background: #fff;\n             border: 1px dashed #cbd5e1; border-radius: 22px; }\n\n    .system { margin-top: 25px; padding: 23px 25px; background: #172554; color: white; border-radius: 20px;\n              display: flex; justify-content: space-between; align-items: center; gap: 18px; flex-wrap: wrap;\n              box-shadow: 0 10px 25px #17255418; }\n    .system h2 { font-size: 16px; margin-bottom: 7px; }\n    .system p { color: #cbd5e1; font-size: 13px; line-height: 1.6; }\n    .last-update { background: #263866; padding: 11px 14px; border-radius: 12px; font-size: 12px; color: #e2e8f0; }\n\n    footer { text-align: center; padding: 25px 15px; color: #94a3b8; font-size: 12px; }\n\n    @media (max-width: 650px) {\n      header { padding: 18px 20px; }\n      main { padding: 32px 16px; }\n      .boards { grid-template-columns: 1fr; }\n      .board { padding: 22px; }\n      .system { align-items: flex-start; }\n    }\n  </style>\n</head>\n\n<body>\n  <header>\n    <div class=\"brand\">\n      <div class=\"brand-icon\">📡</div>\n      <div>Smart <span>IoT</span></div>\n    </div>\n    <div class=\"connection\">\n      <span class=\"dot\" id=\"dot\"></span>\n      <span id=\"status\">Connexion à Node-RED...</span>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"welcome\">\n      <div class=\"eyebrow\">Surveillance en temps réel</div>\n      <h1>Tableau de bord</h1>\n      <p class=\"subtitle\">\n        Mesures envoyées par chaque carte ESP32 (MQTT → Node-RED → WebSocket)\n        et commande de leur actionneur depuis cette page.\n      </p>\n    </section>\n\n    <section class=\"boards\" id=\"boards\">\n      <div class=\"empty\" id=\"empty\">En attente des cartes ESP32…</div>\n    </section>\n\n    <section class=\"system\">\n      <div>\n        <h2>État du système</h2>\n        <p id=\"summary\">Aucune carte connectée pour l'instant.</p>\n      </div>\n      <div class=\"last-update\" id=\"updated\">Dernière réception : --</div>\n    </section>\n  </main>\n\n  <footer>Projet IoT — ESP32 · MQTT · Node-RED · WebSocket · MongoDB Atlas</footer>\n\n  <script>\n    const statusEl = document.getElementById(\"status\");\n    const dot = document.getElementById(\"dot\");\n    const boardsEl = document.getElementById(\"boards\");\n    const emptyEl = document.getElementById(\"empty\");\n    const summaryEl = document.getElementById(\"summary\");\n    const updated = document.getElementById(\"updated\");\n\n    // Etat connu de chaque carte : { mesure, etat, actionneur, ts }\n    const cartes = {};\n\n    // Affichage des grandeurs connues ; les autres s'affichent avec leur nom\n    const GRANDEURS = {\n      temperature: { label: \"TEMPÉRATURE\", unit: \"°C\", cls: \"temperature\" },\n      humidity:    { label: \"HUMIDITÉ\",    unit: \"%\",  cls: \"humidity\" },\n      humidite:    { label: \"HUMIDITÉ\",    unit: \"%\",  cls: \"humidity\" },\n      pressure:    { label: \"PRESSION\",    unit: \"hPa\", cls: \"other\" },\n      motion:      { label: \"MOUVEMENT\",   unit: \"\",   cls: \"other\", texte: v => (v ? \"Oui\" : \"Non\") },\n    };\n    const IGNORER = new Set([\"seq\", \"ok\"]);\n\n    // Port USB de chaque carte sur le PC (pour savoir laquelle est laquelle)\n    // Facultatif : nom affiche devant l'identifiant, ex. \"esp32-39880c\": \"COM4\" (voir le README)\n    const PORTS = {\n    };\n\n    let ws = null;\n    let retryTimer = null;\n    let reconnectDelay = 2000;\n\n    const esc = s => String(s).replace(/[&<>\"']/g, c => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c]));\n\n    function blocCarte(id) {\n      let el = document.getElementById(\"carte-\" + id);\n      if (!el) {\n        el = document.createElement(\"article\");\n        el.className = \"board\";\n        el.id = \"carte-\" + id;\n        boardsEl.appendChild(el);\n      }\n      return el;\n    }\n\n    function afficher(id, flash) {\n      const c = cartes[id];\n      const m = c.mesure || {};\n      const enLigne = c.etat ? c.etat.state === \"online\" : !!c.mesure;\n      const unites = m.units || {};\n\n      const tuiles = Object.entries(m)\n        .filter(([k, v]) => typeof v === \"number\" && !IGNORER.has(k))\n        .map(([k, v]) => {\n          const g = GRANDEURS[k] || { label: k.toUpperCase(), unit: unites[k] || \"\", cls: \"other\" };\n          const texte = g.texte ? g.texte(v) : (Number.isInteger(v) ? v : v.toFixed(1));\n          return `<div class=\"tile ${g.cls}\"><div class=\"label\">${esc(g.label)}</div>\n                  <div class=\"value\">${esc(texte)} <span class=\"unit\">${esc(g.unit)}</span></div></div>`;\n        }).join(\"\") || `<div class=\"tile other\"><div class=\"label\">MESURES</div><div class=\"value\">--</div></div>`;\n\n      const a = c.actionneur;\n      const nomAct = (a && a.actuator) || \"Actionneur\";\n      const etatAct = a ? (a.state === \"on\" ? '<b class=\"on\">ON</b>' : '<b class=\"off\">OFF</b>') : \"inconnu\";\n      const desactive = enLigne ? \"\" : \"disabled\";\n\n      const infos = [\n        m.sensor || (c.etat && c.etat.sensor),\n        c.etat && c.etat.ip,\n        c.etat && c.etat.mesh_level ? (c.etat.mesh_level === 1 ? \"racine du mesh\" : \"mesh niveau \" + c.etat.mesh_level) : null,\n      ].filter(Boolean).map(esc).join(\" · \");\n\n      const el = blocCarte(id);\n      el.classList.toggle(\"offline\", !enLigne);\n      el.innerHTML = `\n        <div class=\"board-top\">\n          <div><div class=\"board-name\">${PORTS[id] ? esc(PORTS[id]) + \" · \" : \"\"}${esc(id.toUpperCase())}</div><div class=\"board-sub\">${infos || \"&nbsp;\"}</div></div>\n          <span class=\"badge ${enLigne ? \"on\" : \"off\"}\">${enLigne ? \"En ligne\" : \"Hors ligne\"}</span>\n        </div>\n        <div class=\"values\">${tuiles}</div>\n        <div class=\"actuator\">\n          <span class=\"actuator-state\">💡 ${esc(nomAct)} : ${etatAct}</span>\n          <span class=\"buttons\">\n            <button class=\"btn-on\" ${desactive} onclick=\"commander('${esc(id)}', 'on')\">Allumer</button>\n            <button class=\"btn-off\" ${desactive} onclick=\"commander('${esc(id)}', 'off')\">Éteindre</button>\n          </span>\n        </div>\n        <p class=\"description\">Dernière mesure : ${c.ts ? new Date(c.ts).toLocaleTimeString() : \"--\"}${m.seq !== undefined ? \" · n°\" + esc(m.seq) : \"\"}</p>`;\n      if (flash) el.querySelectorAll(\".tile\").forEach(t => t.classList.add(\"flash\"));\n      resume();\n    }\n\n    function resume() {\n      const ids = Object.keys(cartes);\n      emptyEl.style.display = ids.length ? \"none\" : \"\";\n      const enLigne = ids.filter(id => (cartes[id].etat ? cartes[id].etat.state === \"online\" : !!cartes[id].mesure)).length;\n      summaryEl.textContent = ids.length\n        ? `${ids.length} carte(s) connue(s), ${enLigne} en ligne.`\n        : \"Aucune carte connectée pour l'instant.\";\n    }\n\n    function retirer(id) {\n      delete cartes[id];\n      const el = document.getElementById(\"carte-\" + id);\n      if (el) el.remove();\n      resume();\n    }\n\n    // 2e sens : page -> WebSocket -> Node-RED -> MQTT tp/<carte>/cmd -> ESP32\n    function commander(id, state) {\n      if (ws && ws.readyState === WebSocket.OPEN) {\n        ws.send(JSON.stringify({ type: \"cmd\", device_id: id, state: state }));\n      }\n    }\n\n    function recevoir(msg) {\n      const id = msg.device_id;\n      if (msg.type === \"snapshot\") {\n        Object.values(msg.cartes || {}).forEach(c => {\n          cartes[c.device_id] = { mesure: c.mesure, etat: c.etat, actionneur: c.actionneur, ts: c.ts };\n          afficher(c.device_id, false);\n        });\n        return;\n      }\n      if (msg.type === \"remove\") { retirer(id); return; }\n\n      if (!msg.type && (msg.temperature !== undefined || msg.humidite !== undefined)) {\n        // Ancien format (noeud inject de test) : {\"temperature\":..,\"humidite\":..}\n        cartes[\"test-inject\"] = Object.assign(cartes[\"test-inject\"] || {}, { mesure: msg, ts: Date.now() });\n        afficher(\"test-inject\", true);\n      } else if (msg.type === \"data\") {\n        cartes[id] = Object.assign(cartes[id] || {}, { mesure: msg.data, ts: msg.ts || Date.now() });\n        afficher(id, true);\n      } else if (msg.type === \"status\") {\n        cartes[id] = Object.assign(cartes[id] || {}, { etat: msg.data });\n        afficher(id, false);\n      } else if (msg.type === \"actuator\") {\n        cartes[id] = Object.assign(cartes[id] || {}, { actionneur: msg.data });\n        afficher(id, false);\n      } else {\n        return;\n      }\n      updated.textContent = \"Dernière réception : \" + new Date().toLocaleTimeString();\n    }\n\n    function connecterWebSocket() {\n      clearTimeout(retryTimer);\n      const protocol = location.protocol === \"https:\" ? \"wss:\" : \"ws:\";\n\n      statusEl.textContent = \"Connexion à Node-RED...\";\n      dot.style.background = \"#f59e0b\";\n\n      ws = new WebSocket(protocol + \"//\" + location.host + \"/ws/nodered\");\n\n      ws.onopen = () => {\n        statusEl.textContent = \"Connecté à Node-RED\";\n        dot.style.background = \"#16a34a\";\n        reconnectDelay = 2000;\n        ws.send(JSON.stringify({ type: \"hello\" }));   // Node-RED renvoie l'état connu des cartes\n      };\n\n      ws.onmessage = (event) => {\n        try {\n          recevoir(JSON.parse(event.data));\n        } catch (error) {\n          console.error(\"Message WebSocket invalide :\", error);\n        }\n      };\n\n      ws.onerror = () => {\n        statusEl.textContent = \"Erreur de connexion\";\n        dot.style.background = \"#dc2626\";\n      };\n\n      ws.onclose = () => {\n        statusEl.textContent = \"Reconnexion en cours...\";\n        dot.style.background = \"#f59e0b\";\n        retryTimer = setTimeout(() => {\n          reconnectDelay = Math.min(reconnectDelay * 1.5, 10000);\n          connecterWebSocket();\n        }, reconnectDelay);\n      };\n    }\n\n    connecterWebSocket();\n  </script>\n</body>\n</html>\n",
